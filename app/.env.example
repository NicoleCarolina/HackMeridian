# The environment to use `development`, `testing`, `staging`, `production`
STELLAR_SCAFFOLD_ENV=development

# Location of the config files for this project for the scaffold stellar CLI.
# Learn more at https://developers.stellar.org/docs/tools/cli/stellar-cli#stellar-config-dir
XDG_CONFIG_HOME=".config"

# Prefix with "PUBLIC_" to make available in frontend files
# Which Stellar network to use in the frontend: local, testnet, futurenet, or mainnet
# More on Stellar networks: https://developers.stellar.org/docs/networks

# ORIGINAL: configuración para trabajar con la red local.
# PUBLIC_STELLAR_NETWORK="LOCAL"
# PUBLIC_STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# PUBLIC_STELLAR_RPC_URL="http://localhost:8000/rpc"
# PUBLIC_STELLAR_HORIZON_URL="http://localhost:8000"

# CAMBIO: utilizamos Stellar Testnet para que el proyecto pueda funcionar
# sin necesidad de levantar una red local con Docker.
PUBLIC_STELLAR_NETWORK="TESTNET"
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# PUBLIC_STELLAR_NETWORK="MAINNET"
# PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# PUBLIC_STELLAR_RPC_URL=
# PUBLIC_STELLAR_HORIZON_URL=

# --- DCA Platform ---
# USDC testnet (Circle). Emisor: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Para obtener el SAC derivado y pegarlo abajo:
#   stellar contract id asset --asset USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5 --network testnet
# NOTA: Soroswap testnet puede no tener pool USDC-circle/XLM. Si no hay liquidez,
# usa un USDC de prueba propio o los tokens de la faucet de Soroswap (XTAR, etc.)
# y cámbialo arriba.
PUBLIC_USDC_CONTRACT=
# SAC del XLM nativo. Obtenlo con:
#   stellar contract id asset --asset native --network testnet
PUBLIC_XLM_CONTRACT=
# Soroswap Router en testnet (ya fijado en environments.toml, aquí por conveniencia frontend).
PUBLIC_SOROSWAP_ROUTER=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD
